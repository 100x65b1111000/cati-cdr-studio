.env
.env.*
!.env.example

# --- Debug + internal-testing artifacts ---
# Screenshots regenerated by `node ui-check.mjs` on every run.
_ui/
# Scratch files: anything prefixed with _ is throwaway investigation.
_*
# Playwright's own run output.
test-results/
playwright-report/
blob-report/
.playwright-mcp/

